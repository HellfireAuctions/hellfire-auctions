{% if product.tags contains 'Hellfire Auction' or product.type == 'Hellfire Auction' %}
<div id="hellfire-auction-root"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ product.selected_or_first_available_variant.id | default: '' }}"
  data-experience-src="{{ 'auction.js' | asset_url }}"></div>
{% endif %}

{% schema %}
{
  "name": "Hellfire Auction",
  "target": "section",
  "javascript": "auction.js",
  "stylesheet": "auction.css",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
