generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                 String    @id
  shop               String
  state              String
  isOnline           Boolean   @default(false)
  scope              String?
  expires            DateTime?
  accessToken        String
  userId             BigInt?
  firstName          String?
  lastName           String?
  email              String?
  accountOwner       Boolean   @default(false)
  locale             String?
  collaborator       Boolean?  @default(false)
  emailVerified      Boolean?  @default(false)
  refreshToken       String?
  refreshTokenExpires DateTime?
}

model Auction {
  id            String   @id @default(cuid())
  shop          String
  productId     String
  title         String
  description   String?
  imageUrl      String?
  startingBid   Float
  currentBid    Float    @default(0)
  bidCount      Int      @default(0)
  reservePrice  Float?
  autoExtend    Boolean  @default(false)
  isTest        Boolean  @default(false)
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("DRAFT")
  winnerId      String?
  winnerCheckoutUrl String?
  winnerDraftOrderId String?
  winnerNotifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bids          Bid[]
  events        BidEvent[]
  watches       Watch[]

  @@index([shop, productId])
  @@index([endsAt])
}

model Bid {
  id          String   @id @default(cuid())
  auctionId   String
  bidderId    String
  bidderEmail String?
  amount      Float
  maxBid      Float    @default(0)
  createdAt   DateTime @default(now())
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  @@index([auctionId])
  @@index([bidderId])
  @@index([auctionId, maxBid])
  @@unique([auctionId, bidderId])
}

model AuctionNotification {
  id         String   @id @default(cuid())
  auctionId  String
  customerId String
  type       String
  key        String
  sentAt     DateTime @default(now())

  @@unique([auctionId, customerId, type, key])
  @@index([auctionId])
}

model ShopPlan {
  shop           String   @id
  plan           String   @default("SPARK")
  subscriptionId String?
  updatedAt      DateTime @updatedAt
}

model BlockedBidder {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  createdAt  DateTime @default(now())

  @@unique([shop, customerId])
}

model BidEvent {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Float
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([bidderId])
}

model Watch {
  id         String   @id @default(cuid())
  shop       String
  auctionId  String
  customerId String
  createdAt  DateTime @default(now())
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([auctionId, customerId])
  @@index([customerId])
}

model NotificationPref {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  outbid     Boolean  @default(true)
  reminders  Boolean  @default(true)
  results    Boolean  @default(true)
  essentialOnly Boolean @default(false)
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([shop, customerId])
}

model ShopSettings {
  shop          String   @id
  autoOfferNext Boolean  @default(true)
  strikeLimit   Int      @default(2)
  defaultWeight Float?
  defaultWeightUnit String @default("OUNCES")
  bidderRule    String   @default("ANYONE")
  approvedTag   String   @default("bidder-approved")
  updatedAt     DateTime @updatedAt
}
