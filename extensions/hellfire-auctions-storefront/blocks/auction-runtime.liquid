{% assign hellfire_product_is_auction = false %}
{% assign hellfire_runtime_product = nil %}
{% if request.page_type == 'product' and handle %}
  {% assign hellfire_runtime_product = all_products[handle] %}
  {% if hellfire_runtime_product.tags contains 'Hellfire Auction' or hellfire_runtime_product.type == 'Hellfire Auction' %}
    {% assign hellfire_product_is_auction = true %}
  {% endif %}
{% endif %}
{% assign hellfire_auction_handles = '' %}
{% if request.page_type == 'collection' and handle %}
  {% assign hellfire_runtime_collection = collections[handle] %}
  {% for p in hellfire_runtime_collection.products %}
    {% if p.tags contains 'Hellfire Auction' or p.type == 'Hellfire Auction' %}
      {% assign hellfire_auction_handles = hellfire_auction_handles | append: p.handle | append: '|' %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if hellfire_product_is_auction %}
<style id="hellfire-auction-critical-hide">
html:has(#hellfire-auction-runtime[data-auction-product="true"]) form[action*="/cart/add"],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) button[name="add"],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) button[type="submit"][name="add"],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) button[data-testid*="add-to-cart"],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) button[data-action="add-to-cart"],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) [data-add-to-cart],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) [data-add-to-cart-button],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) [data-quick-add],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) quick-add-component,
html:has(#hellfire-auction-runtime[data-auction-product="true"]) add-to-cart-component,
html:has(#hellfire-auction-runtime[data-auction-product="true"]) sticky-add-to-cart,
html:has(#hellfire-auction-runtime[data-auction-product="true"]) .price,
html:has(#hellfire-auction-runtime[data-auction-product="true"]) [data-product-price],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) [data-price],
html:has(#hellfire-auction-runtime[data-auction-product="true"]) product-price {
  display:none!important;
  visibility:hidden!important;
  pointer-events:none!important;
}
</style>
{% endif %}

{% if hellfire_auction_handles != blank %}
<style id="hellfire-auction-collection-hide">
{% assign hellfire_handles = hellfire_auction_handles | split: '|' %}
{% for auction_handle in hellfire_handles %}
  {% unless auction_handle == blank %}
  body :is(article,li,product-card,.product-card,.product-item,.card,.card-wrapper,.grid__item,[data-product-id]):has(a[href="/products/{{ auction_handle }}"]) :is(form[action*="/cart/add"],button[name="add"],button[type="submit"][name="add"],button[data-testid*="add-to-cart"],button[data-action="add-to-cart"],[data-add-to-cart],[data-add-to-cart-button],[data-quick-add],quick-add-component,add-to-cart-component,sticky-add-to-cart) {
    display:none!important;
    visibility:hidden!important;
    pointer-events:none!important;
  }
  {% endunless %}
{% endfor %}
</style>

<style id="hellfire-auction-collection-price-hide">
{% for auction_handle in hellfire_handles %}
  {% unless auction_handle == blank %}
  body :is(li,product-card,.product-card,.product-item,.card,.card-wrapper,.grid__item):has(:is(a[href$="/products/{{ auction_handle }}"],a[href*="/products/{{ auction_handle }}?"])) :is(.price,product-price,[data-product-price],[data-price]) {
    display:none!important;
  }
  {% endunless %}
{% endfor %}
</style>
{% endif %}

{%- if hellfire_product_is_auction -%}
<link rel="preload" href="{{ 'auction.js' | asset_url }}" as="script">
<script>
  window.__hellfireAuctionPrefetch = fetch("/apps/hellfire-auctions/auction?product_id=" + encodeURIComponent("gid://shopify/Product/{{ hellfire_runtime_product.id }}"), { credentials: "same-origin", headers: { Accept: "application/json" }, cache: "no-store" })
    .then(function (r) { return r.ok ? r.json() : null; })
    .catch(function () { return null; });
</script>
{%- endif -%}

<meta id="hellfire-auction-runtime"
  data-auction-product="{{ hellfire_product_is_auction }}"
  data-product-id="{{ hellfire_runtime_product.id | default: '' }}"
  data-variant-id="{{ hellfire_runtime_product.selected_or_first_available_variant.id | default: '' }}"
  data-auction-handles="{{ hellfire_auction_handles }}"
  data-experience-src="{{ 'auction.js' | asset_url }}">

<script id="hellfire-early">
(function () {
  try {
    if (window.__hellfireEarly || location.pathname.indexOf("/apps/hellfire-auctions/") !== -1) return;
    var KEY = "hf_cards_v1", TTL = 5 * 60 * 1000;
    var CONT = "li,article,product-card,.product-card,.product-item,.card,.card-wrapper,.grid__item,.grid-product,[data-product-id],[data-product-handle]";
    var PRICE = ".price,product-price,[data-product-price],[data-price],form[action*='/cart/add'],[data-quick-add],quick-add-component,add-to-cart-component";
    var m = location.pathname.match(/\/products\/([^\/?#]+)/);
    var here = m ? decodeURIComponent(m[1]).toLowerCase() : "";
    function ok(h) { return /^[a-z0-9_%\-]+$/i.test(h) && h.toLowerCase() !== here; }
    function link(h) { return 'a:is([href$="/products/' + h + '"],[href*="/products/' + h + '?"],[href*="/products/' + h + '#"])'; }
    function other(h) { return 'a[href*="/products/"]:not(:is([href$="/products/' + h + '"],[href*="/products/' + h + '?"],[href*="/products/' + h + '#"]))'; }
    // a card = a container holding links to this one product only (never a block that mentions several products)
    function card(h) { return ":is(" + CONT + "):has(" + link(h) + "):not(:has(" + other(h) + "))"; }
    function css(d) {
      var out = [], i, h, ended = d.ended || [], live = d.live || [];
      for (i = 0; i < ended.length && i < 150; i++) { h = String(ended[i]); if (ok(h)) out.push(card(h) + "{display:none!important}"); }
      for (i = 0; i < live.length && i < 150; i++) { h = String(live[i]); if (ok(h)) out.push(card(h) + " :is(" + PRICE + "){display:none!important}"); }
      return out.join("\n");
    }
    var style = document.createElement("style");
    style.id = "hellfire-early-hide";
    var saved = null;
    try { saved = JSON.parse(sessionStorage.getItem(KEY) || "null"); } catch (e) {}
    if (saved && Date.now() - saved.t < TTL) style.textContent = css(saved);
    (document.head || document.documentElement).appendChild(style);
    window.__hellfireEarly = {
      update: function (list, serverNow) {
        var byHandle = {}, ended = [], live = [], i, a, h;
        for (i = 0; i < list.length; i++) { a = list[i]; if (a && a.handle) byHandle[String(a.handle).toLowerCase()] = a; }
        for (h in byHandle) {
          a = byHandle[h];
          if (a.status === "LIVE") live.push(h);
          else if (a.status === "ENDED" && serverNow - Date.parse(a.endsAt) > 60000) ended.push(h);
        }
        var d = { t: Date.now(), ended: ended, live: live };
        try { sessionStorage.setItem(KEY, JSON.stringify(d)); } catch (e) {}
        style.textContent = css(d);
      }
    };
    // Ask the server right now, not after the page has loaded.
    window.__hellfireCardsPrefetch = fetch("/apps/hellfire-auctions/auction-cards", { credentials: "same-origin", headers: { Accept: "application/json" } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
  } catch (e) {}
})();
</script>

{%- comment -%} Product-card auction badges: separate script, always on with this embed. {%- endcomment -%}
<script type="application/json" id="hellfire-auction-cards-config">
  {"endpoint": "/apps/hellfire-auctions/auction-cards", "currency": {{ shop.currency | json }}, "locale": {{ request.locale.iso_code | json }}}
</script>
{{ 'auction-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'auction-cards.js' | asset_url }}" defer></script>

{%- comment -%} The "Live Auctions" button: visible as soon as this embed is switched on. {%- endcomment -%}
{%- if block.settings.show_hub -%}
<script type="application/json" id="hellfire-hub-config">
  {
    "endpoint": "/apps/hellfire-auctions/live-auctions",
    "collection": {{ block.settings.hub_collection | default: '/collections/live-auctions' | json }},
    "position": {{ block.settings.hub_position | default: 'right' | json }},
    "label": {{ block.settings.hub_label | json }},
    "hideEmpty": {{ block.settings.hub_hide_when_empty | json }},
    "color": {{ block.settings.hub_color | default: '#1a1a1a' | json }},
    "offset": {{ block.settings.hub_offset | default: 20 | json }},
    "designMode": {{ request.design_mode | json }},
    "locale": {{ request.locale.iso_code | json }},
    "currency": {{ shop.currency | json }}
  }
</script>
{{ 'auction-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'auction-hub.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Hellfire Auctions Runtime",
  "target": "head",
  "javascript": "auction-runtime-v4.js",
  "stylesheet": "auction.css",
  "settings": [
    { "type": "header", "content": "Live Auctions button" },
    { "type": "checkbox", "id": "show_hub", "label": "Show the Live Auctions button", "default": true, "info": "A small button on every page that opens a list of your running auctions. Turn it off if you only want the bidding panel on auction pages." },
    { "type": "select", "id": "hub_position", "label": "Position", "default": "right", "options": [ { "value": "right", "label": "Bottom right" }, { "value": "left", "label": "Bottom left" } ] },
    { "type": "range", "id": "hub_offset", "label": "Distance from the bottom edge", "min": 8, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "text", "id": "hub_label", "label": "Button text", "info": "Leave empty to use \"Live Auctions\" in the shopper's own language." },
    { "type": "color", "id": "hub_color", "label": "Button color", "default": "#1a1a1a" },
    { "type": "checkbox", "id": "hub_hide_when_empty", "label": "Hide the button when no auction is running", "default": false },
    { "type": "url", "id": "hub_collection", "label": "Where \"View all auctions\" goes", "info": "Leave empty to use your Live Auctions collection." }
  ]
}
{% endschema %}