<div id="hellfire-auction-root" data-product-id="{{ block.settings.product.id | default: product.id }}" data-variant-id="{{ block.settings.product.selected_or_first_available_variant.id | default: product.selected_or_first_available_variant.id }}"></div>
<script src="{{ 'auction.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Auction Experience",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "stylesheet": "auction.css",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Auction product",
      "autofill": true
    }
  ]
}
{% endschema %}