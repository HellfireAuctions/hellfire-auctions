<div id="hellfire-auction-runtime" data-product-id="{{ product.id }}" hidden></div>
<script>
  window.__HELLFIRE_AUCTION_PRODUCT_ID = "{{ product.id }}";
</script>
{% schema %}
{
  "name": "Auction Runtime",
  "target": "body",
  "enabled_on": {
    "templates": ["product"]
  },
  "stylesheet": "auction.css",
  "javascript": "auction.js",
  "settings": []
}
{% endschema %}
